# Luma adapter: "mock" (default, no API key needed) or "live" (Phase 2).
LUMA_MODE=mock
# Edge function secrets only (supabase secrets set ...), never in app env files:
# LUMA_API_KEY=            Luma calendar API key (Luma Plus)
# LUMA_WEBHOOK_TOKEN=      random string, 32+ chars, also used in the webhook URL
# SYNC_TIME_BUDGET_MS=     optional, default 100000

# Postgres used by the RLS test suite (plain Postgres 15+ or `supabase start`).
DATABASE_URL=postgres://postgres@localhost:54322/postgres
